# ---- 基础设施 ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_sec
# memory  = 内存向量库 + MemorySaver + 内存审计（默认，无需 Docker）
# postgres= pgvector + PostgresSaver + DB 审计（需先执行 npm run setup）
STORE=memory

# ---- LLM（OpenAI 兼容协议，DeepSeek / 硅基流动 / OpenAI / 本地 vLLM 通用）----
# fake   = 确定性本地应答，零密钥零成本，用来跑通链路与测试（语义质量会退化）
# openai = 走 OpenAI 兼容 /chat/completions
LLM_PROVIDER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# 换供应商只改 3 行，安全链路一行都不用动。例如：
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1      LLM_MODEL=deepseek-chat
#   硅基流动:    LLM_BASE_URL=https://api.siliconflow.cn/v1    LLM_MODEL=<平台模型名>
# ⚠️ LLM_BASE_URL 必须 HTTPS（仅本机可 http），URL 内不允许夹带凭据/查询串。

# ---- Embedding（可选，独立凭据，不与 LLM 共用）----
# DeepSeek 等 chat 端点不提供 /embeddings（实测 404）。
# 三项留空 → 自动降级 local-hash：链路可跑，但无语义检索能力。
# 要真语义检索请单独配一个 embedding 服务，向量维度必须是 1536。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---- LangSmith 可观测性（真实 key 只放本地 .env，不要提交）----
# 复制后把 true 改为开启；开启后 prompt / 工具参数 / 输出会发送到 LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-security-lab
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- 安全预算（fail-closed 默认值，调大前先想清楚攻击面）----
MAX_INPUT_CHARS=8000
MAX_OUTPUT_CHARS=4000
MAX_STEPS=12
MAX_TOTAL_TOKENS=20000
MAX_WALL_MS=60000
RATE_LIMIT_PER_MIN=20
MAX_TOOL_OUTPUT_CHARS=6000

# ---- 工具出口白名单（空 = 完全禁止工具出网）----
ALLOWED_HTTP_HOSTS=
